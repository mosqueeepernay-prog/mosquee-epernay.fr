---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Page d'accueil — squelette Phase 0.
 * Le contenu complet (hero, horaires de prière, annonces…) arrive en Phase 3.
 */
---

<BaseLayout>
  <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight text-brand-800 sm:text-5xl">Mosquée d'Épernay</h1>

    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Site officiel — contenu en cours de préparation.
    </p>

    <p class="mt-6 max-w-2xl text-sm text-ink-500">
      Phase 0 : architecture du projet (Astro + React + TypeScript + Tailwind CSS). Les sections,
      les horaires de prière et les informations officielles seront ajoutées après validation par le
      comité.
    </p>
  </section>
</BaseLayout>
