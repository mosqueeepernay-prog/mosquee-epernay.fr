---
/**
 * Layout de base : <html lang/dir>, métadonnées SEO (title, description,
 * canonical, hreflang, Open Graph), en-tête, bandeau et pied de page.
 *
 * La locale et la page sont déduites du chemin courant (i18n/routes.ts),
 * ce qui garantit un lang/dir et des liens hreflang toujours cohérents.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AnnouncementBanner from '../components/shared/AnnouncementBanner.astro';
import { LOCALE_INFO } from '../i18n/config';
import { getDictionary } from '../i18n/dictionaries';
import { resolveRoute } from '../i18n/routes';
import { canonicalFor, hreflangLinks, ogLocale } from '../lib/seo';
import { SITE } from '../lib/site';

interface Props {
  /** Surchage optionnelle du <title> (sinon : titre de la page). */
  title?: string;
  /** Surchage optionnelle de la meta description. */
  description?: string;
}

const { title, description } = Astro.props;
const { locale, slug } = resolveRoute(Astro.url.pathname);

const dict = getDictionary(locale);
const info = LOCALE_INFO[locale];
const pageContent = slug ? dict.pages[slug] : null;

// Nom du site : FR depuis site.ts, AR depuis le dictionnaire (nom de travail).
const siteName = locale === 'ar' ? dict.site.name : SITE.name;
const pageTitle = title ?? pageContent?.title ?? siteName;
const pageDescription = description ?? pageContent?.description;

const canonical = canonicalFor(locale, slug, Astro.url.pathname);
const alternates = hreflangLinks(slug);
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <!-- Encodage explicite : requis (Astro n'injecte pas <meta charset>). -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}

    <!-- Canonical + hreflang (FR par défaut, AR sous /ar/, x-default = FR) -->
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1a5549" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(locale === 'ar' ? 'fr' : 'ar')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
  </head>

  <body class="flex min-h-dvh flex-col bg-sand-50 text-ink-900">
    <a class="skip-link" href="#main-content">
      {dict.a11y.skipToContent}
    </a>

    <AnnouncementBanner />
    <Header locale={locale} currentSlug={slug} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} currentSlug={slug} />
  </body>
</html>
