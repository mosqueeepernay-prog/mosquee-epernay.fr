---
/**
 * Bouton partagé — `<a>` si `href`, sinon `<button>`.
 * Cible tactile minimum : 44 px (min-h-11).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'onDark' | 'onDarkOutline';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  ariaLabel,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-150';

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-brand-700 text-white hover:bg-brand-800',
  secondary: 'bg-gold-400 text-ink-900 hover:bg-gold-500',
  outline: 'border border-brand-300 bg-white text-brand-700 hover:bg-brand-50',
  ghost: 'text-brand-700 hover:bg-brand-50',
  onDark: 'bg-white text-brand-800 hover:bg-sand-100',
  onDarkOutline: 'border border-white/70 text-white hover:bg-white/10',
};

const sizes: Record<NonNullable<Props['size']>, string> = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    <slot />
  </button>
)}
