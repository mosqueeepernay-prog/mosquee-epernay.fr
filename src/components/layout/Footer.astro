---
/**
 * Pied de page : navigation, contact, réseaux sociaux, mentions légales.
 * PLACEHOLDER : aucune donnée officielle (adresse, téléphone, SIRET, réseaux)
 * n'est fournie — volontairement non affichée, uniquement signalée.
 */
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { NAV_ORDER, ROUTES, type PageSlug } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';
import { SITE } from '../../lib/site';

interface Props {
  locale: Locale;
  currentSlug: PageSlug | null;
}

const { locale, currentSlug } = Astro.props;
const dict = getDictionary(locale);
// Nom affiché : FR depuis site.ts, AR depuis le dictionnaire (nom de travail).
const siteName = locale === 'ar' ? dict.site.name : SITE.name;
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-sand-200 bg-white">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Marque + langue -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <Logo label={dict.a11y.logoPlaceholder} />
        <span class="flex flex-col leading-tight">
          <span class="font-extrabold text-brand-800">{siteName}</span>
          <span class="text-xs uppercase tracking-wider text-ink-400">{dict.site.tagline}</span>
        </span>
      </div>
      <LangSwitcher locale={locale} currentSlug={currentSlug} />
    </div>

    <!-- Navigation -->
    <nav aria-label={dict.a11y.footerNav}>
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink-800">{dict.footer.navTitle}</h2>
      <ul class="mt-3 flex flex-col">
        {NAV_ORDER.map((slug) => (
          <li>
            <a
              href={ROUTES[locale][slug]}
              aria-current={currentSlug === slug ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center text-sm underline-offset-4 transition-colors hover:text-brand-700 hover:underline',
                currentSlug === slug ? 'font-semibold text-brand-700' : 'text-ink-600',
              ]}
            >
              {dict.nav[slug]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Contact + réseaux sociaux (placeholders) -->
    <div class="flex flex-col gap-6">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-ink-800">
          {dict.footer.contactTitle}
        </h2>
        <p class="mt-2 rounded-xl border border-dashed border-brand-300 bg-brand-50/60 p-3 text-sm text-ink-600">
          {dict.footer.contactPlaceholder}
        </p>
      </div>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-ink-800">
          {dict.footer.socialTitle}
        </h2>
        <p class="mt-2 rounded-xl border border-dashed border-brand-300 bg-brand-50/60 p-3 text-sm text-ink-600">
          {dict.footer.socialPlaceholder}
        </p>
      </div>
    </div>

    <!-- Mentions légales -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-ink-800">
        {dict.footer.legalTitle}
      </h2>
      <p class="mt-2 rounded-xl border border-dashed border-brand-300 bg-brand-50/60 p-3 text-sm text-ink-600">
        {dict.footer.legalPlaceholder}
      </p>
    </div>
  </div>

  <div class="border-t border-sand-200">
    <div class="container-page flex flex-col gap-2 py-6 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {siteName} — {dict.footer.rights}
      </p>
      <p>{dict.footer.builtNote}</p>
    </div>
  </div>
</footer>
