---
/**
 * Sélecteur de langue FR / AR.
 * Chaque langue pointe vers la page équivalente (routes pré-calculées).
 * Cible tactile minimum : 44 px.
 */
import { getDictionary } from '../../i18n/dictionaries';
import { ROUTES, type PageSlug } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  currentSlug: PageSlug | null;
}

const { locale, currentSlug } = Astro.props;
const dict = getDictionary(locale);
const slug: PageSlug = currentSlug ?? 'home';

const options = [
  { target: 'fr' as Locale, label: 'FR', lang: 'fr', title: dict.lang.fr },
  { target: 'ar' as Locale, label: 'العربية', lang: 'ar', title: dict.lang.ar },
];
---

<nav
  aria-label={dict.a11y.langSwitcher}
  class="inline-flex shrink-0 items-center gap-1 rounded-full border border-sand-300 bg-white p-1"
>
  {options.map((option) => (
    <a
      href={ROUTES[option.target][slug]}
      lang={option.lang}
      hreflang={option.lang}
      title={option.title}
      aria-label={option.title}
      aria-current={locale === option.target ? 'true' : undefined}
      class:list={[
        'inline-flex min-h-11 items-center justify-center rounded-full px-4 text-sm font-bold transition-colors',
        locale === option.target
          ? 'bg-brand-700 text-white'
          : 'text-ink-600 hover:bg-sand-100 hover:text-brand-700',
      ]}
    >
      {option.label}
    </a>
  ))}
</nav>
