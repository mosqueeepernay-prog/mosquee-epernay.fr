---
/**
 * Bloc « dons » — PLACEHOLDER.
 * Aucune donnée bancaire, aucune plateforme, aucun moyen de paiement actif.
 */
import Heading from '../shared/Heading.astro';
import Button from '../shared/Button.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { ROUTES } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const donation = dict.home.donation;
---

<section class="bg-brand-800 py-12 text-white sm:py-16" aria-labelledby="donation-title">
  <div class="container-page grid gap-8 lg:grid-cols-2 lg:items-center">
    <div>
      <Heading as="h2" id="donation-title" class="text-white">
        {donation.title}
      </Heading>
      <p class="mt-3 max-w-xl leading-relaxed text-brand-100">{donation.text}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={ROUTES[locale].dons} variant="onDark">
          {donation.cta}
        </Button>
      </div>
    </div>

    <!-- PLACEHOLDER : coordonnées de don à fournir par le comité. -->
    <div class="rounded-2xl border-2 border-dashed border-white/50 bg-white/5 p-6">
      <span class="inline-flex rounded-full bg-gold-400 px-3 py-1 text-xs font-bold uppercase tracking-wide text-ink-900">
        {dict.common.badgeDev}
      </span>
      <p class="mt-3 text-lg font-semibold">{donation.iban}</p>
      <p class="mt-2 text-sm text-brand-100">{donation.note}</p>
    </div>
  </div>
</section>
