---
/**
 * Bloc « horaires de prière ».
 *
 * Données : architecture provider (src/lib/prayer-times/).
 *   UI → getPrayerTimes() → PrayerTimesProvider → MawaqitProvider
 *
 * Tant qu'aucune source officielle n'est configurée, `times` vaut `null` et
 * les cartes affichent « --:-- » — aucune heure n'est jamais inventée.
 * Le design (cartes, typographie, espacements, responsive) est inchangé.
 */
import Heading from '../shared/Heading.astro';
import Button from '../shared/Button.astro';
import PrayerTimesCards from '../prayer/PrayerTimesCards.astro';
import PrayerSourceLabel from '../prayer/PrayerSourceLabel.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { ROUTES } from '../../i18n/routes';
import { NEXT_PRAYER_KEYS, PRAYER_KEYS, getPrayerTimes } from '../../lib/prayer-times';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const prayer = dict.home.prayer;
const time = dict.common.timePlaceholder;

const times = await getPrayerTimes();

// Candidats « prochaine prière » (le lever du soleil en est exclu).
// En l'absence de données officielles, la liste est vide et le « --:-- » reste.
const nextEntries = NEXT_PRAYER_KEYS.map((key) => ({
  name: prayer.prayers[PRAYER_KEYS.indexOf(key)] ?? key,
  time: times?.[key] ?? '',
})).filter((entry) => entry.time !== '');
---

<section class="bg-sand-50 py-12 sm:py-16" aria-labelledby="prayer-times-title">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Heading as="h2" id="prayer-times-title">
          {prayer.title}
        </Heading>
        <p class="mt-1 text-sm font-medium uppercase tracking-wide text-ink-400">
          {prayer.subtitle}
        </p>
      </div>
      <Button href={ROUTES[locale]['horaires-priere']} variant="outline">
        {prayer.allTimes}
      </Button>
    </div>

    <PrayerTimesCards times={times} class="mt-6" />

    <!-- Prochaine prière : « --:-- » sans données ; enrichi côté client uniquement
         quand la source officielle fournit le jour complet (amélioration progressive,
         les cartes elles-mêmes ne dépendent jamais de JavaScript). -->
    <div class="mt-4 flex flex-wrap items-center gap-3 rounded-2xl border-2 border-dashed border-brand-300 bg-brand-50/60 p-4">
      <span class="rounded-full bg-brand-700 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
        {prayer.next}
      </span>
      <span class="font-bold tabular-nums text-ink-800" data-next-prayer aria-live="polite">
        {time}
        {nextEntries.map((entry) => (
          <span hidden data-name={entry.name} data-time={entry.time} />
        ))}
      </span>
      <p class="text-sm text-ink-500">{prayer.note}</p>
    </div>

    <PrayerSourceLabel times={times} class="mt-3" />
  </div>
</section>

<script>
  import { mosqueLocalTime } from '../../lib/prayer-times/date';

  // Amélioration progressive : affiche la prochaine prière selon l'heure de la
  // mosquée (Europe/Paris), jamais selon celle du visiteur. Sans JavaScript ou
  // sans données, le « --:-- » rendu côté serveur reste affiché.
  document.querySelectorAll('[data-next-prayer]').forEach((node) => {
    const entries = Array.from(node.querySelectorAll('[data-time]'))
      .map((element) => ({
        name: element.getAttribute('data-name') ?? '',
        time: element.getAttribute('data-time') ?? '',
      }))
      .filter((entry) => entry.name !== '' && entry.time !== '');

    if (entries.length === 0) return;

    const now = mosqueLocalTime();
    if (now === '') return;

    const next = entries.find((entry) => entry.time > now) ?? entries[0];
    node.textContent = `${next.name} · ${next.time}`;
  });
</script>
