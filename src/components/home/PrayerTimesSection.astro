---
/**
 * Bloc « horaires de prière » — PLACEHOLDER Phase 1.
 * Aucun horaire réel : les valeurs affichées sont des tirets.
 * Le calcul arrive en Phase 2 (src/lib/prayerConfig.ts).
 */
import Heading from '../shared/Heading.astro';
import Button from '../shared/Button.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { ROUTES } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const prayer = dict.home.prayer;
const time = dict.common.timePlaceholder;
---

<section class="bg-sand-50 py-12 sm:py-16" aria-labelledby="prayer-times-title">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Heading as="h2" id="prayer-times-title">
          {prayer.title}
        </Heading>
        <p class="mt-1 text-sm font-medium uppercase tracking-wide text-ink-400">
          {prayer.subtitle}
        </p>
      </div>
      <Button href={ROUTES[locale]['horaires-priere']} variant="outline">
        {prayer.allTimes}
      </Button>
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {prayer.prayers.map((name) => (
        <li class="rounded-2xl border border-sand-200 bg-white p-4 text-center shadow-sm">
          <p class="text-sm text-ink-500">{name}</p>
          <p class="mt-1 text-xl font-bold tabular-nums text-brand-700">{time}</p>
        </li>
      ))}
    </ul>

    <!-- PLACEHOLDER : prochaine prière / compte à rebours (Phase 2). -->
    <div class="mt-4 flex flex-wrap items-center gap-3 rounded-2xl border-2 border-dashed border-brand-300 bg-brand-50/60 p-4">
      <span class="rounded-full bg-brand-700 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
        {prayer.next}
      </span>
      <span class="font-bold tabular-nums text-ink-800">{time}</span>
      <p class="text-sm text-ink-500">{prayer.note}</p>
    </div>

    <p class="mt-3 text-sm text-ink-400">{dict.common.phase2}</p>
  </div>
</section>
