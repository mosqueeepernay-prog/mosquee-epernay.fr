# =============================================================================
# Variables d'environnement — Site officiel de la Mosquée d'Épernay
# =============================================================================
# Usage : copier ce fichier vers `.env` (ignoré par Git) et renseigner UNIQUEMENT
# les valeurs fournies officiellement par MAWAQIT.
#
# ⚠️ Règles :
#  - ne JAMAIS committer `.env` ni aucun secret (clé, token, mot de passe) ;
#  - ne JAMAIS inventer d'endpoint, de clé ou d'URL de widget ;
#  - les variables sans préfixe PUBLIC_ restent côté serveur / build uniquement.
# =============================================================================

# Identifiant officiel de la mosquée sur MAWAQIT
# (fiche « Mosquée Abou Bakr - Epernay »).
MAWAQIT_MOSQUE_ID=11002

# Endpoint officiel du flux d'horaires MAWAQIT.
# VIDE tant que MAWAQIT n'en a pas fourni aucun → aucun appel réseau,
# les cartes affichent « --:-- ». Ne jamais deviner d'URL.
MAWAQIT_API_URL=

# Secret éventuel fourni par MAWAQIT (jamais de valeur par défaut).
# Côté serveur uniquement — ne jamais utiliser PUBLIC_MAWAQIT_API_KEY.
MAWAQIT_API_KEY=

# URL du widget officiel MAWAQIT (solution de repli).
# VIDE tant qu'aucune URL officielle n'est autorisée → aucun iframe.
MAWAQIT_WIDGET_URL=
